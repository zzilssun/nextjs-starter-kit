FROM node:20-alpine

# 빌드 도구 및 git 설치
RUN apk add --no-cache git python3 make g++ bash

WORKDIR /app

# 의존성 파일 복사 및 설치
COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci --prefer-offline || npm install

# 소스코드 전체 복사
COPY . .

# Prisma 클라이언트 생성
RUN npx prisma generate

# 기본 엔트리포인트: 검증 하네스 풀스캔 실행
CMD ["npx", "tsx", "scripts/verify-harness.ts", "--full"]
