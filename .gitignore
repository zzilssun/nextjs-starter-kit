# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (ignore all env files)
.env*
!.env.example
!.env.development.example
!.env.staging.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local database
dev.db
dev.db-journal
*.sql

# antigravity scratch directory and planning artifacts
/scratch
implementation_plan.md

# oracle cloud ssh keys and configs
/oracle cloud
*.key
*.key.pub

# playwright test directories
.playwright_*
scripts/.playwright_*
scripts/output/

# autonomous harness runtime artifacts
.harness/

# obscura headless browser binaries and storage
.obscura/
.obscura_storage/
*.tar.gz

# local test image samples
/image sample/
/image sample

# stitch generated exports and artifacts
/docs/stitch/exports/
/docs/stitch/screens/
/docs/stitch/.auth.json
